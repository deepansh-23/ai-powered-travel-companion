# AI Powered Travel Companion - Environment Configuration Template
# Copy this file to .env and fill in your API keys.

# -----------------------------------------------------------------------
# Operation mode
# MOCK_MODE=true  → use bundled sample data; no external API calls needed.
# MOCK_MODE=false → use real Geoapify + Gemini APIs (requires keys below).
# -----------------------------------------------------------------------
MOCK_MODE=false

# -----------------------------------------------------------------------
# Geoapify API Key (required when MOCK_MODE=false)
# Used for: geocoding, nearby places, cafes, medical facilities.
# Get yours at: https://www.geoapify.com/
# -----------------------------------------------------------------------
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# -----------------------------------------------------------------------
# Google Gemini API Key (required when MOCK_MODE=false)
# Used for: itinerary generation, area guide summarization.
# Get yours at: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------
# Optional: Gemini model override (defaults to gemini-1.5-flash)
# -----------------------------------------------------------------------
AI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------
# SerpApi Key (required for Google Flights and Google Hotels searches)
# Used for: real-time flight search, hotel discovery, pricing & comparisons.
# Get yours at: https://serpapi.com/
# -----------------------------------------------------------------------
SERPAPI_API_KEY=your_serpapi_api_key_here

# -----------------------------------------------------------------------
# RailRadar API Key (optional / for Indian rail integration)
# Used for: train search, station lookup and which classes (SL/3AC/2AC/1AC) a train has.
# Note: RailRadar does not provide fares or seat availability, so the app never shows them
# for RailRadar results (it links to IRCTC instead).
# -----------------------------------------------------------------------
RAILRADAR_API_KEY=your_railradar_api_key_here

# -----------------------------------------------------------------------
# Google reCAPTCHA Keys (optional in dev, required in production)
# -----------------------------------------------------------------------
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# -----------------------------------------------------------------------
# Server settings (optional overrides)
# -----------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# -----------------------------------------------------------------------
# Website URL validation (optional)
# When true, HEAD requests verify that place URLs are reachable.
# -----------------------------------------------------------------------
VERIFY_WEBSITES=false


# -----------------------------------------------------------------------
# PostgreSQL (Aiven): user accounts, login sessions, per-user History,
# Reviews and Saved sessions. Copy the values from the Aiven console
# (Connection information). Leave DB_HOST empty to run WITHOUT accounts
# (public features still work). Never commit the real values.
# -----------------------------------------------------------------------
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Aiven CA certificate (download ca.pem from the Aiven console into the project root)
DB_SSL_CA=ca.pem

# Login sessions
AUTH_SESSION_DAYS=14
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Guest sessions (people who use the planner without an account)
GUEST_SESSION_HOURS=24
# Secret used to sign guest cookies. Leave empty to generate a random one at start-up
# (guests just start a new guest session after a server restart). Example: python -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=
